# ===== 拨号模式 =====
# app = HTTP 直连手机 App（推荐，全自动拨号）
# adb = ADB 无线调试（备用，可能需手动确认）
DIAL_MODE=app

# ===== 手机 App 配置（推荐方式）=====
# 手机上打开「一键拨号助手」App，界面上显示的 IP 地址
APP_HOST=192.168.1.100
# App 固定端口，默认 8888，一般不用改
APP_PORT=8888

# ===== ADB 无线调试配置（备用方式）=====
# 仅在 DIAL_MODE=adb 时使用
ADB_DEVICE_IP=192.168.1.100
ADB_DEVICE_PORT=5555

# Flask 服务端口
FLASK_PORT=5000

# Flask 调试模式（生产环境设为 False）
FLASK_DEBUG=True
